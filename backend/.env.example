# Local overrides for backend/server.js.
#
# Copy to backend/.env and run with:
#   node --env-file=.env server.js
# Render supplies these values itself (see render.yaml).

# Port to listen on. Render sets PORT automatically there.
PORT=3001

# Folder where users.json is written. Point this at a mounted disk in
# production (e.g. /var/data) so the file survives deploys.
# DATA_DIR=./data

# Comma-separated browser origins allowed to call the API. "*" allows any.
CORS_ORIGIN=http://localhost:5173
