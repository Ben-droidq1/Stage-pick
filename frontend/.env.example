# Google OAuth client ID for the "Continue with Google" button.
# A web client ID is public (it ships in the page source), so this file is safe
# to share. Copy it to .env.local to override the value compiled into the app.
VITE_GOOGLE_CLIENT_ID=660620187732-nmt5jr5uocj77fq5181j3knk360hnqon.apps.googleusercontent.com

# Base URL of the user API (backend/). Defaults to the Render deployment.
# Point this at http://localhost:3001 when running the API locally.
# VITE_API_URL=https://stage-pick.onrender.com
